# Build-time values injected into the bundle (public; shown in the footer and /health.json).
# CI sets these automatically. Locally they default to package.json version and `git rev-parse HEAD`.
VITE_APP_VERSION=1.0.0
VITE_COMMIT_SHA=0000000000000000000000000000000000000000

# Never put secrets in VITE_* variables: they are embedded in the public JavaScript bundle.
